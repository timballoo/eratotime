# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Loaded by config.php via env.php (see env.php for the loader).

# --- Database ---
ERATO_DB_HOST=localhost
ERATO_DB_NAME=
ERATO_DB_USER=
ERATO_DB_PASS=

# --- Encryption ---
# Path to the sodium key file used for credentials_encrypted (created on first
# use). Keep it outside the web root if possible.
ERATO_ENC_KEY_PATH=../eratotime-keys/enc.key

# --- App ---
ERATO_BASE_URL=https://www.meertec.ltd
ERATO_ALTCHA_HMAC_KEY=

# --- SMTP (Hostinger mailbox, stephen@meertec.ltd) ---
ERATO_SMTP_HOST=
ERATO_SMTP_PORT=465
ERATO_SMTP_USER=
ERATO_SMTP_PASS=
ERATO_SMTP_SECURE=ssl
ERATO_SMTP_FROM=stephen@meertec.ltd

# --- CalDAV (Baikal calendar of record) ---
# Used by bin/setup_caldav.php to encrypt credentials into calendar_sources.
ERATO_CALDAV_URL=https://www.meertec.ltd/baikal/html/dav.php/calendars/stephen@meertec.ltd/default/
ERATO_CALDAV_USERNAME=stephen@meertec.ltd
ERATO_CALDAV_PASSWORD=
