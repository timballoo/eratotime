# Eratotime — routing + web-serve guard.

# --- Public booking routing: /t/{tenant}/book/{type} -> book.php -----------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^t/([^/]+)/book/([^/]+)/?$ book.php?tenant=$1&type=$2 [L,QSA]

    # --- Deny CLI/private directories (bin, cron, db, tests) if the app is
    # deployed inside a web-served directory. api/ and uploads/ stay reachable.
    RewriteRule ^(bin|cron|db|tests)(/|$) - [F,L]
</IfModule>

# --- Web-serve guard --------------------------------------------------------
# If this app is ever deployed inside a web-served directory (e.g. Hostinger
# public_html/eratotime), deny direct HTTP access to the secret-bearing files.
# The preferred deployment puts the app OUTSIDE the web root; this is the
# belt-and-braces for the in-web-root layout.

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env|\.env\..*|config\.php|.*\.key)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.env|\.env\..*|config\.php|.*\.key)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
