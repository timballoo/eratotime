# rsync ignore filters (used by .github/workflows/deploy.yml).
# `P` = PROTECT: the file is never deleted by --delete (rsync deletes excluded
#     files by default!). Use P for anything that lives only on the server.
# `-` = exclude from transfer (deletion is fine if it ever appears).

- .git/
- .github/
- preview.php
- .phpunit.cache/
- phpunit.xml
- tests/

# Server-only: never transfer, never delete.
P .env
P config.php
P uploads/
