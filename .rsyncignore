# rsync ignore filters (used by .github/workflows/deploy.yml).
# `-` excludes from transfer AND protects from --delete.
# Secrets (and local-only/dev files) are never deployed; uploads/ is server
# content that CI must never overwrite or delete.

- .git/
- .env
- config.php
- preview.php
- .phpunit.cache/
- phpunit.xml
- tests/
- uploads/
