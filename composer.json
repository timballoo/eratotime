{
    "name": "meertec/eratotime",
    "description": "Personal self-hosted booking request tool (request-submission model, see docs/eratotime-requirements.md)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "google/apiclient": "^2.16",
        "phpmailer/phpmailer": "^6.9",
        "altcha-org/altcha": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "availability_lib.php",
            "tenant_lib.php"
        ]
    },
    "autoload-dev": {
        "files": [
            "tests/bootstrap.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
